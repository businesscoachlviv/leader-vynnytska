      "--ease-in-out",
      "--ease-out",
      "--font-mono",
      "--font-sans",
      "--font-serif",
      "--fs-base",
      "--fs-display",
      "--fs-eyebrow",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-h4",
      "--fs-lg",
      "--fs-sm",
      "--fs-xs",
      "--gold",
      "--gold-tint",
      "--hairline",
      "--hairline-2",
      "--info",
      "--ink",
      "--ink-2",
      "--ink-3",
      "--ink-4",
      "--lh-loose",
      "--lh-normal",
      "--lh-snug",
      "--lh-tight",
      "--on-ink",
      "--paper",
      "--paper-2",
      "--paper-3",
      "--r-lg",
      "--r-md",
      "--r-pill",
      "--r-sm",
      "--r-xl",
